{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/contracts/response-envelope.schema.json",
  "title": "ResponseEnvelope",
  "type": "object",
  "required": ["code", "message", "traceId", "meta"],
  "properties": {
    "code": { "type": "integer" },
    "message": { "type": "string" },
