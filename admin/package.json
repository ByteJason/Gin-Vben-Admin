{
  "name": "gin-vben-admin-monorepo",
  "version": "5.7.0",
  "private": true,
  "keywords": [
    "monorepo",
    "turbo",
    "gin",
    "go",
    "gin-vben-admin",
    "gin vben admin",
    "vue",
    "vue admin",
    "vue vben admin",
    "vue3"
  ],
  "homepage": "https://github.com/ByteJason/Gin-Vben-Admin",
  "bugs": "https://github.com/ByteJason/Gin-Vben-Admin/issues",
  "repository": "ByteJason/Gin-Vben-Admin.git",
  "license": "MIT",
  "author": {
    "name": "Gin-Vben-Admin contributors",
    "url": "https://github.com/ByteJason/Gin-Vben-Admin"
  },
  "type": "module",
  "scripts": {
    "bootstrap": "pnpm install",
    "build": "node ./scripts/profile-gate.mjs --command build && cross-env NODE_OPTIONS=--max-old-space-size=8192 node ./scripts/selected-dispatch.mjs --command build",
    "changeset": "pnpm exec changeset",
    "check": "pnpm run check:circular && pnpm run check:dep && pnpm run check:type && pnpm check:cspell",
    "check:circular": "vsh check-circular",
    "check:cspell": "cspell lint \"**/*.ts\" \"**/README.md\" \".changeset/*.md\" --no-progress",
    "check:dep": "vsh check-dep",
    "check:type": "turbo run typecheck",
    "clean": "node ./scripts/clean.mjs",
    "commit": "czg",
    "dev": "node ./scripts/profile-gate.mjs --command dev && node ./scripts/selected-dispatch.mjs --command dev",
    "format": "vsh lint --format",
    "init": "node ./scripts/init.mjs",
    "ui:select": "node ./scripts/ui-select.mjs",
    "ui:check": "node ./scripts/ui-select.mjs --check",
    "ui:install": "node ./scripts/ui-install.mjs",
    "lint": "vsh lint",
    "postinstall": "node ./scripts/postinstall.mjs",
    "prepare": "is-ci || pnpm exec lefthook install",
    "preview": "node ./scripts/profile-gate.mjs --command preview && node ./scripts/selected-dispatch.mjs --command preview",
    "publint": "vsh publint",
    "reinstall": "pnpm run clean -- --del-lock && pnpm install",
    "test:benchmark": "vitest bench --run",
    "test:e2e:a11y": "pnpm --filter @vben/web-antd run build && pnpm --filter @vben/web-ele run build && pnpm --filter @vben/web-naive run build && pnpm --filter @gin-vben-admin/install run build:installer && playwright test --config playwright.config.ts",
    "test:unit": "vitest run --dom",
    "test:e2e": "turbo run test:e2e",
    "update:deps": "npx taze -r -w",
    "version": "pnpm exec changeset version && pnpm install --no-frozen-lockfile",
    "catalog": "pnpm dlx codemod pnpm/catalog",
    "test:smoke": "node --test tests/smoke.test.mjs tests/production-admin-contract.test.mjs tests/manage-access-contract.test.mjs tests/init-cli.test.mjs tests/non-destructive-selection.test.mjs tests/docker-ui.test.mjs tests/postinstall.test.mjs tests/pnpm-command.test.mjs tests/dependency-log.test.mjs tests/dependency-runner.test.mjs tests/process-identity.test.mjs"
  },
  "dependencies": {
    "sortablejs": "catalog:"
  },
  "devDependencies": {
    "@axe-core/playwright": "catalog:",
    "@changesets/changelog-github": "catalog:",
    "@changesets/cli": "catalog:",
    "@playwright/test": "catalog:",
    "@tsdown/css": "catalog:",
    "@types/node": "catalog:",
    "@vben/commitlint-config": "workspace:*",
    "@vben/eslint-config": "workspace:*",
    "@vben/oxfmt-config": "workspace:*",
    "@vben/oxlint-config": "workspace:*",
    "@vben/stylelint-config": "workspace:*",
    "@vben/tailwind-config": "workspace:*",
    "@vben/tsconfig": "workspace:*",
    "@vben/turbo-run": "workspace:*",
    "@vben/vite-config": "workspace:*",
    "@vben/vsh": "workspace:*",
    "@vitejs/plugin-vue": "catalog:",
    "@vitejs/plugin-vue-jsx": "catalog:",
    "cross-env": "catalog:",
    "cspell": "catalog:",
    "eslint": "catalog:",
    "happy-dom": "catalog:",
    "is-ci": "catalog:",
    "lefthook": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "playwright": "catalog:",
    "rimraf": "catalog:",
    "tailwindcss": "catalog:",
    "tsdown": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "vue": "catalog:",
    "vue-tsc": "catalog:"
  },
  "engines": {
    "node": "^22.18.0 || ^24.12.0",
    "pnpm": ">=11.0.0"
  },
  "packageManager": "pnpm@11.16.0"
}
