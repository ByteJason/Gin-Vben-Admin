{
  "version": 1,
  "description": "生产代码中仍保留的固定 SQL 调用。每一项必须有稳定 ID、用途和可运行的验证命令。",
  "rules": [
    {
      "id": "MIGRATION_POSTGRES_TABLE_COMMENT",
      "path": "server/migrations/schema.go",
      "line_regex": "\\.Exec\\(statement,",
      "reason": "PostgreSQL 的表备注由 GORM Migrator 建表后使用 COMMENT ON TABLE 写入；表名和备注均来自固定模型映射。",
      "test": "go -C server test ./migrations -run TestCreateTableDDLHasCommentsAndNoForeignKeys"
    },
    {
      "id": "MIGRATION_V002_POSTGRES_TABLE_COMMENT",
      "path": "server/migrations/versions/admin/v002_common_capabilities.go",
      "line_regex": "\\.Exec\\(statement,",
      "reason": "公共能力版本迁移为 PostgreSQL 新增表写入固定模型备注；表名和备注均来自持久化模型注册表。",
      "test": "go -C server test ./migrations/versions/admin -run TestCommonCapabilities"
    },
    {
      "id": "MIGRATION_V002_METADATA_BACKFILL",
      "path": "server/migrations/versions/admin/v002_common_capabilities.go",
      "line_regex": "\\.Unscoped\\(\\)\\.Model\\(&persistencemodel\\.FileObject",
      "reason": "旧 file_objects 行的新增 JSON 元数据列需包含软删除记录的固定 {} 回填，随后才收紧 NOT NULL。",
      "test": "go -C server test ./migrations/versions/admin -run TestMetadataCompatibility"
    },
    {
      "id": "IAM_AUTHORIZATION_SCOPE_COMPAT",
      "path": "server/internal/platform/iamplatform/gorm_store.go",
      "line_regex": "\\.Table\\(\\\"iam_data_scopes",
      "reason": "授权决策的组织范围查询保留兼容适配器，供现有授权契约测试固定主库路由；业务写入使用 gorm.G[T]。",
      "test": "go -C server test ./internal/platform/iamplatform -run Test.*Authorization"
    },
    {
      "id": "IAM_ACTIVE_ROLE_JOIN_COMPAT",
      "path": "server/internal/platform/iamplatform/gorm_store.go",
      "line_regex": "\\.(Table|Joins)\\(\\\"(user_roles AS ur|JOIN roles AS r)",
      "reason": "旧 sqlmock 契约的查询构造器适配器；实际角色解析路径使用 gorm.G[T] 固定投影，关系字段不生成外键。",
      "test": "go -C server test ./internal/platform/iamplatform -run Test.*Role"
    },
    {
      "id": "IAM_PERMISSION_JOIN_COMPAT",
      "path": "server/internal/platform/iamplatform/gorm_store.go",
      "line_regex": "\\.(Table|Joins)\\(\\\"(iam_policies AS ip|JOIN permissions AS p)",
      "reason": "保留权限解析的旧查询构造器测试适配器；正式查询返回 projection row 并绑定全部运行时参数。",
      "test": "go -C server test ./internal/platform/iamplatform -run Test.*Permission"
    },
    {
      "id": "TASKS_RUN_LOG_JOIN_PROJECTION",
      "path": "server/internal/platform/tasks/gorm_repository.go",
      "line_regex": "\\.Raw\\(sql",
      "reason": "任务日志需要跨 run 的租户/组织过滤；这是列清单固定、参数全部绑定的只读 projection，无法由无关联模型的泛型链表达。",
      "test": "go -C server test ./internal/platform/tasks -count=1"
    },
    {
      "id": "IMPORT_ERRORS_JOB_JOIN_PROJECTION",
      "path": "server/internal/platform/imports/gorm_repository.go",
      "line_regex": "\\.Raw\\(sql",
      "reason": "导入错误需要跨 job 的租户/组织过滤；这是列清单固定、参数全部绑定的只读 projection，无法由无关联模型的泛型链表达。",
      "test": "go -C server test ./internal/platform/imports -count=1"
    }
  ]
}
