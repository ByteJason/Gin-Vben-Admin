{
  "uid": "gin-vben-admin-observability",
  "title": "Gin-Vben-Admin Observability",
  "schemaVersion": 39,
  "version": 1,
  "panels": [
    {
      "type": "timeseries",
      "title": "HTTP requests per second",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "targets": [{"expr": "sum(rate(app_http_requests_total[5m]))", "refId": "A"}]
    },
    {
      "type": "timeseries",
      "title": "HTTP 5xx rate",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "targets": [{"expr": "sum(rate(app_http_requests_total{status=~\"5..\"}[5m]))", "refId": "A"}]
    },
    {
      "type": "stat",
      "title": "OTLP dropped spans",
      "gridPos": {"h": 5, "w": 8, "x": 0, "y": 8},
      "targets": [{"expr": "sum(app_observability_export_dropped_total)", "refId": "A"}]
    }
  ]
}
