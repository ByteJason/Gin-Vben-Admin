# 可选的部署环境模板。首次安装直接打开 /install，无需复制此文件。
# 手工部署时复制为 .env 并 chmod 600；真实连接与密钥仅保存在本机。
# 管理界面只由 admin/.ui-profile.local.json 选择，不在 .env 重复配置。
# 业务设置在管理端维护；未指定的运行参数采用服务端 typed config 默认值。

SERVER_ADDR=":8080"
LOGGING_LEVEL=info
SITE_NAME="Gin-Vben-Admin"
SITE_LOGO=""

# /install 会写入实际数据库、Redis 连接及认证密钥。
DATABASE_ENABLED=false
DATABASE_DRIVER=postgres
DATABASE_MODE=single
REDIS_ENABLED=false
REDIS_MODE=single
REDIS_ADDR="127.0.0.1:6379"
AUTH_ENABLED=false
