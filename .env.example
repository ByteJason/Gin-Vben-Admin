# Gin-Vben-Admin 根目录运行环境模板（可选）。
#
# 复制为 .env 后将权限设为 0600：
#   cp .env.example .env
#   chmod 600 .env
#
# /install 完成首次安装后会原子更新这个文件并写入数据库、Redis 与认证
# 配置。不要把真实密码、DSN、JWT 或其他令牌提交到 Git。

# 管理端运行分发；可选 antd、ele、naive。
APP_UI_ACTIVE=antd
APP_UI_MODE=dev

# HTTP 与日志
SERVER_ADDR=":8080"
# info 使用精简启动输出；需要路由诊断时改为 debug。
LOGGING_LEVEL=info

# 首次启动保持无外部依赖；安装页提交后会写入实际连接信息。
DATABASE_ENABLED=false
DATABASE_DRIVER=mysql
DATABASE_MODE=single
REDIS_ENABLED=false
REDIS_MODE=single
REDIS_ADDR="127.0.0.1:6379"

# 认证默认关闭；启用时请在本机设置至少 32 字节的 AUTH_JWT_SECRET。
AUTH_ENABLED=false

# 默认语言
I18N_MODE=single
I18N_DEFAULT_LOCALE=zh-CN
I18N_SUPPORTED_LOCALES="zh-CN,en-US"
